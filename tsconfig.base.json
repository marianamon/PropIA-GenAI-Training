{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@propia/shared": ["packages/shared/src/index.ts"],
      "@propia/shared/*": ["packages/shared/src/*"],
      "@propia/embeddings": ["packages/embeddings/src/index.ts"],
      "@propia/db": ["packages/db/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
