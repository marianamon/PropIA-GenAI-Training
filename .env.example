# PropIA — variables de entorno
# Copia este archivo a `.env` y rellena los valores.

# Claude API — obtén tu key en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-tu-key-aqui

# ChromaDB (queda corriendo en localhost vía docker compose up)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Modelo de embeddings local (sin API key, descarga al primer uso)
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
